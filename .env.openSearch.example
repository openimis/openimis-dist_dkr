DISCOVERY_TYPE=single-node
CLUSTER_NAME=my_opensearch_cluster
OPENSEARCH_DSL_AUTOSYNC=True

######################
# Security plugin
######################

# The cluster can run with the OpenSearch security plugin: TLS on 9200, every
# request authenticated, and the identity headers from the gate trusted only
# from Dashboards' address.
#
# It ships OFF, and that is a temporary state. The backend verifies the
# cluster's private certificate authority through OPENSEARCH_CA_CERTS, which no
# released image carries yet. With the plugin on and an older BE_TAG the stack
# looks healthy - migrations pass, the app serves, the gate works - while every
# indexing call fails with a certificate error, so the reports feature is dead
# without saying so. Off is the honest default until a release image has it.
#
# To turn it on, once your BE_TAG does: set the four passwords below, change
# these three lines to
#   OPENSEARCH_SECURITY_DISABLED=false
#   OPENSEARCH_HOSTS=https://opensearch:9200
#   OPENSEARCH_DASHBOARDS_HOSTS=["https://opensearch:9200"]
# and read CONTRIBUTOR.md, which covers the one-time reload an installation
# that has already started the cluster needs.
#
# With it off the cluster trusts every container on its network, so network
# isolation is the only control.
OPENSEARCH_SECURITY_DISABLED=true

# Internal users. All three passwords must be set when the plugin is on - the
# node refuses to start and names the empty one. Generate each with:
#   openssl rand -base64 24
# "admin", the cluster superuser: operators and the healthcheck, nothing else.
OPENSEARCH_SUPERUSER_PASSWORD=
# The indexer, what the backend and worker connect as. The variable names are
# the backend's (settings/opensearch.py reads OPENSEARCH_ADMIN/_PASSWORD); the
# user is not the superuser.
OPENSEARCH_ADMIN=openimis_indexer
OPENSEARCH_PASSWORD=
# Dashboards' own server user.
OPENSEARCH_DASHBOARDS_PASSWORD=
# Encrypts the Dashboards session cookie. 32 characters or more.
OPENSEARCH_DASHBOARDS_COOKIE_PASSWORD=

# The cluster trusts identity headers from this address only: Dashboards'
# fixed address on the opensearch-net subnet. Change both only if the subnet
# collides with one already routed on the host.
OPENSEARCH_NET_SUBNET=172.29.0.0/24
OPENSEARCH_DASHBOARDS_IP=172.29.0.250

# The backend's connection, scheme included: https with the plugin on.
OPENSEARCH_HOSTS=http://opensearch:9200
# Dashboards' connection, JSON-array form - the two are not interchangeable.
OPENSEARCH_DASHBOARDS_HOSTS=["http://opensearch:9200"]
