# GlitchTip error monitoring — used by compose.logs.yml.
# Copy to .env.logs before the first `docker compose up`; the include in
# compose.yml requires the file to exist.

## Database for the GlitchTip instance (separate from the openIMIS DB)
GLITCHTIP_DB_NAME=glitchtip
GLITCHTIP_DB_USER=glitchtip
GLITCHTIP_DB_PASS=change_me_in_production

## Superuser created by the bootstrap; it owns the organization
GLITCHTIP_SUPERUSER_EMAIL=admin@openimis.org
GLITCHTIP_SUPERUSER_PASSWORD=change_me_in_production

## Organization the bootstrap creates the projects under
GLITCHTIP_ORG_SLUG=openimis
GLITCHTIP_ORG_NAME=OpenIMIS

## Host baked into the generated DSNs. Leave empty to use https://${DOMAIN}/logs
GLITCHTIP_PUBLIC_HOST=
## Optional in-network route for backend events, e.g. http://glitchtip:8000/logs
GLITCHTIP_INTERNAL_HOST=

## Set to 1 to re-run the bootstrap even if conf/glitchtip/.setup.lock exists
FORCE_GLITCHTIP_INIT=0
