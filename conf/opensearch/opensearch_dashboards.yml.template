# Rendered by dashboards-start.sh into config/opensearch_dashboards.yml when
# the security plugin is on. Hosts, the server user, the CA and the base path
# come from the compose environment (the image turns them into flags, which
# override this file). Everything under opensearch_security.* can only live
# here: the image does not map keys with an underscore.
server.host: "0.0.0.0"
opensearch.ssl.verificationMode: full
# Headers relayed from the gate to the cluster. authorization is deliberately
# absent: the gate clears it, and the cluster must never see a client-sent one.
opensearch.requestHeadersAllowlist: ["x-forwarded-for", "x-proxy-user", "x-proxy-rights", "securitytenant"]
opensearch_security.auth.type: "proxy"
opensearch_security.proxycache.user_header: "x-proxy-user"
opensearch_security.proxycache.roles_header: "x-proxy-rights"
opensearch_security.multitenancy.enabled: true
# Global holds the shipped dashboards, read-only for everyone but 199003.
opensearch_security.multitenancy.tenants.enable_global: true
# Private is the point: what a user saves is theirs alone.
opensearch_security.multitenancy.tenants.enable_private: true
# A request with no securitytenant header lands in the first of these.
# upload_opensearch_dashboards sends none, so the shipped dashboards go to
# Global and stay readable by everyone.
opensearch_security.multitenancy.tenants.preferred: ["Global", "Private"]
# Dev Tools lets a user issue raw index requests as themselves - the one path
# around the tenant layer to another user's saved objects. Nothing in openIMIS
# needs it.
console.enabled: false
# The gate recomputes identity on every request; the cookie only caches it.
opensearch_security.cookie.secure: false
opensearch_security.cookie.password: "__COOKIE_PASSWORD__"
