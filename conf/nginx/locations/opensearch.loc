
    # Authorizes Dashboards against openIMIS rights, not merely a valid session.
    # 200 right held, 403 right missing, 401 no session -> login.
    # The 200 also carries X-Auth-User / X-Auth-Rights, copied upstream below.
    location = /check_opensearch/ {
        internal;
        proxy_pass http://${backend}/${REACT_APP_API_URL}/opensearch_reports/auth_check;
        proxy_method GET;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header Host $host;
        proxy_set_header X-Original-URI $request_uri;
    }

    location /opensearch/ {
        auth_request /check_opensearch/;
        # Identity from the 200, forwarded below. A backend that does not
        # set them leaves these empty, and nginx then omits the header
        # entirely rather than sending a blank one - so this gate can land
        # before the backend that fills it does.
        auth_request_set $auth_user   $upstream_http_x_auth_user;
        auth_request_set $auth_rights $upstream_http_x_auth_rights;
        # auth_request can only deny; 403 passes through unchanged.
        error_page 401 = @openimis_login;

        proxy_pass http://${opensearch};
        proxy_set_header   Host $host;
        proxy_set_header   X-Real-IP $remote_addr;
        proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto https;
        proxy_set_header   X-Forwarded-Host $server_name;
        # The cluster's proxy authenticator reads these two under whatever
        # names its roles_header/user_header are set to, and files the codes
        # as backend roles. Dashboards relays a header onwards only if it is
        # listed in opensearch.requestHeadersAllowlist, which these are not
        # yet - so for now they stop there.
        proxy_set_header   x-proxy-user $auth_user;
        proxy_set_header   x-proxy-rights $auth_rights;
        proxy_set_header Authorization "Basic ${OPENSEARCH_BASIC_TOKEN}";

    }

    location @openimis_login {
        return 302 /${PUBLIC_URL}/login;
    }
